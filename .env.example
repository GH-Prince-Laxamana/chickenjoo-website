# Copy to .env.local in the project root, beside package.json.
# Use the same database user, cluster, and database name as the shared project.
# Replace every placeholder. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=chickenjoo

# Set the exact public origin in production, especially behind a reverse proxy.
# APP_ORIGIN=https://chickenjoo-website.vercel.app
# Optional: only use a header your trusted proxy overwrites (never client-supplied).
# AUTH_TRUSTED_IP_HEADER=x-vercel-forwarded-for
# Without a trusted IP header, auth has an additional shared 100-attempt/15-minute limit.

# Optional: needed only for npm run setup:admin, not for Menu or Branches.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=<choose-a-password-with-at-least-16-characters>
