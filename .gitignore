# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep credentials local; share only the placeholder template.
.env*
!.env.example
# Maintained checks are versioned in tools/; local scratch tests stay ignored.
/tests/

# Local scratch scripts are ignored; maintained commands live in tools/.
/scripts/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agents/
.claude/

docs/
